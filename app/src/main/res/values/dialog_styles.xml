<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AndroidX Preference uses AppCompat AlertDialog, not MaterialAlertDialogBuilder. -->
    <style name="ThemeOverlay.QVLP.PreferenceDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface_background</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/dialog_text_primary</item>
        <item name="colorPrimary">@color/dialog_accent</item>
        <item name="colorAccent">@color/dialog_accent</item>
        <item name="android:colorAccent">@color/dialog_accent</item>
        <item name="colorControlActivated">@color/dialog_accent</item>
        <item name="colorControlNormal">@color/dialog_outline</item>
        <item name="colorControlHighlight">@color/dialog_selection</item>
        <item name="android:textColorPrimary">@color/dialog_text_primary</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
        <item name="android:textColorHint">@color/dialog_text_secondary</item>
        <item name="android:textColorHighlight">@color/dialog_selection</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.QVLP.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.QVLP.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.QVLP.DialogButton</item>
    </style>

    <style name="Widget.QVLP.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_action_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
