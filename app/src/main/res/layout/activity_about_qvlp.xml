<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBlue"
    android:fillViewport="true"
    tools:context=".AboutQvlpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/iconImageButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/qvlp_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_logo_description" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="44sp"
                android:textColor="@color/yellow"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/yellow"
            android:padding="16dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:id="@+id/detailsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_qvlp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/darkBlue"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/textViewEdition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_description"
                android:textColor="@color/darkBlue" />

            <TextView
                android:id="@+id/textViewVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_version"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewReleaseDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_release_date"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_authors_label"
                android:textStyle="bold"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/textViewAuthors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_authors"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/textViewProfessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_professor"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/textViewLab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_lab"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewUniversity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_university"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/umLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/umlogo"
            android:contentDescription="@string/university_logo_description"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
