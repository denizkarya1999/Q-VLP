<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:theme="@style/ThemeOverlay.QVLP.PreferenceDialog" android:paddingHorizontal="24dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/position_entry_help" android:textColor="@color/dialog_text_secondary" android:textSize="14sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@+id/positionIdInput" android:text="@string/position_id"
        android:layout_marginTop="12dp" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
    <androidx.appcompat.widget.AppCompatEditText android:id="@id/positionIdInput"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:padding="12dp" android:background="@drawable/dialog_value_background" app:backgroundTint="@null"
        android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_secondary"
        android:textColorHighlight="@color/dialog_selection" android:textCursorDrawable="@drawable/dialog_value_cursor"
        android:textSize="18sp" android:inputType="number" android:singleLine="true" android:importantForAutofill="no" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@+id/positionXInput" android:text="@string/position_x"
        android:layout_marginTop="12dp" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
    <androidx.appcompat.widget.AppCompatEditText android:id="@id/positionXInput"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:padding="12dp" android:background="@drawable/dialog_value_background" app:backgroundTint="@null"
        android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_secondary"
        android:textColorHighlight="@color/dialog_selection" android:textCursorDrawable="@drawable/dialog_value_cursor"
        android:textSize="18sp" android:inputType="numberDecimal|numberSigned" android:singleLine="true" android:importantForAutofill="no" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@+id/positionYInput" android:text="@string/position_y"
        android:layout_marginTop="12dp" android:textColor="@color/dialog_text_primary" android:textSize="14sp" />
    <androidx.appcompat.widget.AppCompatEditText android:id="@id/positionYInput"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:padding="12dp" android:background="@drawable/dialog_value_background" app:backgroundTint="@null"
        android:textColor="@color/dialog_text_primary" android:textColorHint="@color/dialog_text_secondary"
        android:textColorHighlight="@color/dialog_selection" android:textCursorDrawable="@drawable/dialog_value_cursor"
        android:textSize="18sp" android:inputType="numberDecimal|numberSigned" android:singleLine="true" android:importantForAutofill="no" />
        <TextView android:id="@+id/positionError" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/dialog_text_primary" android:textStyle="bold"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
