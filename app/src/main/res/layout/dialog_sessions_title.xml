<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="20dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/sessionDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/saved_sessions_title" android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?android:attr/textColorPrimary" />
    <TextView android:id="@+id/sessionSelectionHint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/session_selection_help"
        android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
