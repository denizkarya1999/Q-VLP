<?xml version="1.0" encoding="utf-8"?>
<!-- A settings checkbox, drawn here because the theme's own tick takes the colour of the box and disappears. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true" android:drawable="@drawable/setting_checkbox_checked_disabled" />
    <item android:state_enabled="false" android:drawable="@drawable/setting_checkbox_unchecked_disabled" />
    <item android:state_checked="true" android:drawable="@drawable/setting_checkbox_checked" />
    <item android:drawable="@drawable/setting_checkbox_unchecked" />
</selector>
